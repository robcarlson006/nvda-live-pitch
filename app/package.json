{
  "name": "nvda-live-pitch",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --ignore ./src --ignore ./state.json server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "node --import tsx --test server/*.test.ts scripts/*.test.ts shared/*.test.ts",
    "typecheck": "tsc --noEmit",
    "data": "tsx scripts/build-data.ts && tsx scripts/research-data.ts && tsx scripts/model.ts",
    "shoot": "tsx scripts/shoot.ts",
    "filmstrip": "tsx scripts/filmstrip.ts",
    "follow-eval": "tsx scripts/follow-eval.ts",
    "xlsx": "tsx scripts/xlsx.ts",
    "xlsx-check": "tsx scripts/xlsx-check.ts",
    "fallback": "tsx scripts/fallback.ts",
    "check": "bash ../loop/check.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "echarts": "^6.1.0",
    "framer-motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sirv": "^3.0.2",
    "ws": "^8.23.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "exceljs": "^4.4.0",
    "playwright-core": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}

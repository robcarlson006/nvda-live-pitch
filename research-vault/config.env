# Overnight research loop config (human-owned; the loop cannot change it).
# Phase 1 (research) runs RESEARCH_HOURS from start, then phase 2 (visuals, stronger model) runs VISUAL_HOURS.
RESEARCH_HOURS=6
VISUAL_HOURS=2
# Models by task (ChatGPT plan via Codex). Each TOPICS.md line picks [luna] or [terra].
LUNA_MODEL=gpt-6-luna        # quick sweeps: history, lists, named deals
LUNA_EFFORT=medium
TERRA_MODEL=gpt-6.1-terra    # careful research: financials, ESG, risks; and the consolidation passes
TERRA_EFFORT=medium
CONSOLIDATE_EFFORT=high
CONSOLIDATE_EVERY=5          # every 5th research iteration is a consolidation pass (conflicts, board-readiness gaps)
VISUAL_MODEL=gpt-6.2-sol     # the "more powerful model" for phase 2 visuals
VISUAL_EFFORT=medium         # high burns the usage window much faster
ITER_TIMEOUT_MIN=30          # hard kill for one iteration
MAX_CONSECUTIVE_FAILS=3      # 3 red/no-change iterations in a row: stop (saves usage)
LIMIT_WAIT_MIN=20            # on a 5-hour usage limit: wait, then retry (bounded by the phase clock)
MIN_FREE_GB=5
CODEX_FLAGS=(--sandbox workspace-write -c approval_policy=never -c sandbox_workspace_write.network_access=true -c model_auto_compact_token_limit=120000 -c tool_output_token_limit=6000 --ephemeral)
